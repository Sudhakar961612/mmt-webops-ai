# Server configuration
PORT=5000

# MongoDB connection string
# In-memory MongoDB is auto-started when MONGODB_URI is empty and AUTO_MONGODB_MEMORY=true
MONGODB_URI=mongodb://127.0.0.1:27017/mmt-webops-ai
AUTO_MONGODB_MEMORY=false

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Demo Mode: when true, Playwright runs against local demo pages (works with no external site)
DEMO_MODE=true
# Public base URL used to construct demo page URLs (the Express server serves /demo/* pages)
PUBLIC_BASE_URL=http://localhost:5000

# Playwright
BROWSER_HEADLESS=true
BROWSER_EXECUTABLE_PATH=

# Scheduler (node-cron) - enable so scheduled tasks run automatically
ENABLE_SCHEDULER=true

# Optional AI provider (OpenAI-compatible). Leave AI_API_KEY empty to use the
# deterministic fallback so the full workflow runs with no external AI.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2

# Logging
LOG_LEVEL=info
