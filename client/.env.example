# Development uses Vite's /api proxy, so this is intentionally unset locally.
#
# In the frontend hosting provider, set this value to the PUBLIC backend URL
# followed by /api, then redeploy the frontend. Vite embeds this value at build
# time; changing it without redeploying will not update the deployed app.
# VITE_API_BASE_URL=https://your-backend.example.com/api
